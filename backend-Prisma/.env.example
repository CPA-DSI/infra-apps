# Chaîne de connexion PostgreSQL (voir https://pris.ly/d/connection-strings)
DATABASE_URL="postgresql://user:password@localhost:5432/itinfra_bdd?schema=public"

# Secret utilisé pour signer les JWT
JWT_SECRET="change-me-use-a-random-string-of-at-least-32-characters"

# Clé de chiffrement AES-256-GCM pour le champ pass_mail (mot de passe des boîtes mail).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASS_MAIL_ENCRYPTION_KEY="change-me-64-hex-characters-generated-with-crypto-randomBytes-32"

# Port d'écoute du serveur (optionnel, 4000 par défaut)
PORT=4000

# URL(s) du frontend autorisée(s) en production, séparées par des virgules
CORS_ORIGIN="https://votre-application-frontend.com"

# À définir sur "production" en prod (désactive les logs de debug)
NODE_ENV=production

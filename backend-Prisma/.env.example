# Chaîne de connexion PostgreSQL (voir https://pris.ly/d/connection-strings)
DATABASE_URL="postgresql://user:password@localhost:5432/itinfra_bdd?schema=public"

# Secret utilisé pour signer les JWT
JWT_SECRET="change-me"

# Port d'écoute du serveur (optionnel, 4000 par défaut)
PORT=4000

# URL(s) du frontend autorisée(s) en production, séparées par des virgules
FRONTEND_URL="https://votre-application-frontend.com"

# À définir sur "production" en prod (désactive les logs de debug)
NODE_ENV=production
